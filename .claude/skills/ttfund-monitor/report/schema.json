{
  "$schema": "https://clowder.ai/schemas/report-structure-v1",
  "$id": "report-structure-v1",
  "title": "Report Structure Contract (custom — NOT JSON Schema draft-07)",
  "description": "Custom structural contract for report.md. This is NOT a JSON Schema document despite the $schema key. It defines required sections, content markers, table presence, and blocker semantics. Consumers: LLM output spec + validate-report.cjs. Validation is done by validate-report.cjs inline logic, not by a generic JSON Schema validator.",
  "version": "1.0.0",

  "sections": {
    "0": {
      "prefix": "0.",
      "required": true,
      "mustContain": ["本轮风向", "根因链", "操作倾向", "排除项"],
      "minTables": 0
    },
    "0.5": {
      "prefix": "0.5",
      "required": true,
      "mustContain": ["全局覆盖", "关键指标覆盖", "全局置信度", "操作建议等级"],
      "minTables": 1
    },
    "0.6": {
      "prefix": "0.6",
      "required": true,
      "mustContain": ["源健康度", "新鲜度分布", "陈旧告警", "质量总评"],
      "minTables": 2
    },
    "1": {
      "prefix": "1.",
      "required": true,
      "minSourceTags": 5
    },
    "2": {
      "prefix": "2.",
      "required": true,
      "mustContain": ["资产方向", "跨资产联动", "主导驱动力", "不确定性", "辅助标签"],
      "subsections": {
        "minRequired": 4,
        "prefixes": ["2.1", "2.2", "2.4", "2.5"]
      },
      "minTables": 2
    },
    "3": {
      "prefix": "3.",
      "required": true,
      "mustContain": ["持仓影响", "操作建议"],
      "subsections": {
        "minRequired": 9,
        "prefixes": ["3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8", "3.9"]
      }
    },
    "4": {
      "prefix": "4.",
      "required": true,
      "mustContain": ["主导叙事", "美国端", "中国端"],
      "subsections": {
        "minRequired": 2,
        "prefixes": ["美国端", "中国端"]
      }
    },
    "5": {
      "prefix": "5.",
      "required": true,
      "mustContain": ["组合状态", "组合风险映射", "持仓逐项影响"],
      "minTables": 3
    },
    "6": {
      "prefix": "6.",
      "required": true,
      "mustContain": ["场景树", "不操作的理由", "判断失效条件", "复检时点"],
      "subsections": {
        "minRequired": 5,
        "prefixes": ["6.1", "6.2", "6.3", "6.4", "6.5"]
      }
    },
    "7": {
      "prefix": "7.",
      "required": true,
      "minTables": 1
    },
    "8": {
      "prefix": "8.",
      "required": false,
      "note": "Optional — only output when significant improvement findings exist"
    }
  },

  "globalConstraints": {
    "runIdInFirstLines": true,
    "forbiddenGlobalPatterns": [
      "~约",
      "来源: memory",
      "来源：memory"
    ]
  },

  "blockerSemantics": {
    "blockedOutputCh6": "无法给出行动建议",
    "forbiddenActions": [
      "加仓", "减仓", "买入", "卖出",
      "超配", "低配", "增持", "减持",
      "add", "reduce", "buy", "sell", "overweight", "underweight"
    ],
    "forbiddenContextPatterns": [
      "\\*\\*[^*\\n]{0,80}{action}[^*\\n]{0,80}\\*\\*",
      "建议[^。，\\n]{0,20}{action}"
    ]
  },

  "sourceLabeling": {
    "format": "{adapter} {commandKey}",
    "validAdapters": ["ttfund", "iFinD", "Wind", "mx-data", "WebSearch", "EastMoney", "计算"],
    "minTotalTags": 20
  }
}
